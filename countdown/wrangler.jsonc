{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "countdown",
    "main": "src/worker.js",
    "compatibility_date": "2025-12-01",
    "workers_dev": false,
    "preview_urls": false,
    "assets": {
        "directory": "./public",
        "binding": "ASSETS",
        "run_worker_first": [
            "/api/*",
            "/admin/api/*"
        ]
    },
    "durable_objects": {
        "bindings": [
            {
                "name": "LOTTERY",
                "class_name": "Lottery"
            }
        ]
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": [
                "Lottery"
            ]
        }
    ]
}
